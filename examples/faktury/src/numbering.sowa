desc Numeracja faktur: FV/2026/0001, FV/2026/0002, ...
why decyzje/002-numeracja-bez-luk.md

type InvoiceNumber = String(starts_with(α, "FV/"))
  desc Numer faktury w formacie FV/rok/kolejny numer, np. FV/2026/0042.
fn format_number(year: Int, seq: Int(α > 0)) -> InvoiceNumber
  example format_number(2026, 42) == "FV/2026/0042"

  return "FV/" + to_string(year) + "/" + pad_left(to_string(seq), 4, "0")

fn save_with_next_number(buyer: Buyer, lines: List<Line>(len(α) > 0), discount: Percent,
                         issued_on: Date) -> Invoice | NumberingFailed
  effects Db.read, Db.write

  desc Nadaje kolejny numer i zapisuje fakturę w jednej transakcji.
  why decyzje/002-numeracja-bez-luk.md

  // Składnia transakcji to otwarte pytanie. Tu transaction to zwykła funkcja z lambdą:
  // jeśli coś się nie uda, wszystkie zapisy są wycofywane i wynik to DbError.
  match transaction(() =>
    seq = last_invoice_seq(issued_on.year) + 1
    invoice = Invoice(
      number: format_number(issued_on.year, seq),
      buyer: buyer,
      lines: lines,
      discount: discount,
      issued_on: issued_on,
      status: Issued,
    )
    save_invoice(invoice)
    return invoice
  )
    Invoice i => return i
    DbError   => return NumberingFailed

fn last_invoice_seq(year: Int) -> Int(α >= 0)
  effects Db.read

fn save_invoice(invoice: Invoice)
  effects Db.write
