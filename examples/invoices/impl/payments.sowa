fn mark_paid(invoice: Invoice(α.status == Issued), amount: Price) -> Invoice | PaymentError
  effects Db.write

  if amount != totals(invoice.lines, invoice.discount).gross
    return WrongAmount
  paid = invoice with status: Paid
  save_invoice(paid)
  return paid

// Wywołujący nie wie, jaki status ma faktura z bazy, więc musi to sprawdzić.
fn pay_from_bank(invoice: Invoice, amount: Price) -> Invoice | PaymentError
  effects Db.write

  unpaid = invoice as Invoice(α.status == Issued) or return AlreadyPaid
  return try mark_paid(unpaid, amount)

