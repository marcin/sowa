fn mark_paid(invoice: Invoice(α.status == Issued), amount: Price, db: Db)
    -> Invoice(α.status == Paid) | PaymentError
  if amount != totals(invoice.lines, invoice.discount).gross
    return WrongAmount
  paid = invoice with status: Paid
  save_invoice(paid, db)
  return paid

// Wywołujący nie wie, jaki status ma faktura z bazy, więc musi to sprawdzić.
fn pay_from_bank(invoice: Invoice, amount: Price, db: Db) -> Invoice(α.status == Paid) | PaymentError
  unpaid = invoice as Invoice(α.status == Issued) or return AlreadyPaid
  return try mark_paid(unpaid, amount, db)

