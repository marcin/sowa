desc Typy wspólne dla całego projektu.
why zalozenia.md#kwoty

type Price    = Money(α > 0)
type Percent  = Int(α >= 0 && α <= 100)
  desc Rabat procentowy, od 0 do 100 włącznie.
type Quantity = Int(α > 0)
  desc Liczba sztuk na pozycji. Zero sztuk to nie pozycja, tylko jej brak.
type Name     = String(len(trim(α)) > 0)
type Email    = String(valid_email(α))
type Nip      = String(len(α) == 10 && only_digits(α) && nip_checksum_ok(α))
  desc Numer NIP: 10 cyfr, bez kresek i spacji, z poprawną sumą kontrolną. Tekst od użytkownika zamienia {read_nip}.
  why zalozenia.md#nip

type VatRate = Vat23 | Vat8 | Vat5 | Vat0 | Exempt
  doc uzytkownik/faktury.md#stawki-vat

fn vat_percent(rate: VatRate) -> Percent
  desc Stawka VAT w procentach. Zwolnienie (Exempt) liczy się jak 0%.

  example vat_percent(Vat23) == 23
  example vat_percent(Exempt) == 0

fn read_nip(input: String) -> Nip | InvalidNip
  desc Zamienia NIP wpisany przez użytkownika (z kreskami lub spacjami) na Nip.

  example read_nip("123-456-32-18") == "1234563218"
  example read_nip("123") == InvalidNip
