type InvoiceForm
  buyer_name: String
  buyer_nip: String
  buyer_email: String
  discount: Int
  lines: List<Line>

type IssueError = InvalidBuyer | InvalidNip | InvalidEmail | InvalidDiscount | EmptyInvoice
  | NumberingFailed

