fn to_ksef(invoice: Invoice) -> KsefInvoice(α.gross == α.net + α.vat && α.number == invoice.number)
  t = totals(invoice.lines)
  lines = invoice.lines.map(l => KsefLine(
    name: l.name,
    quantity: l.quantity,
    unit_net: l.unit_net,
    vat_percent: vat_percent(l.vat),
  ))
  return KsefInvoice(
    number: invoice.number,
    issued_on: invoice.issued_on,
    buyer_name: invoice.buyer.name,
    buyer_nip: invoice.buyer.nip,
    lines: lines,
    net: t.net,
    vat: t.vat,
    gross: t.gross,
  )

fn send_to_ksef(invoice: Invoice(α.status == Issued), ksef: Http, db: Db, clock: Clock)
    -> Invoice(α.status is SentToKsef) | KsefError
  // Adres bazowy i token są w [resources] w sowa.toml; tu tylko ścieżka.
  match ksef.post("/invoices", to_json(to_ksef(invoice)))
    HttpResponse response =>
      if response.status != 200
        return KsefRejected(reason: response.body)
      answer = response.body as KsefAnswer or return KsefUnavailable
      return mark_sent(invoice, answer.reference, clock.now(), db)
    HttpError => return KsefUnavailable
