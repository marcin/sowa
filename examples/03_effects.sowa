// Efekty: linia effects mówi, co funkcja robi poza liczeniem.
// Funkcja bez effects jest czysta.

fn cart_total(cart: Cart) -> Money
  return sum(cart.items.map(i => i.price * i.quantity))

fn get_user(id: UserId) -> User
  effects Db.read

fn save_receipt(receipt: Receipt)
  effects Db.write

fn send_receipt(email: Email, receipt: Receipt)
  effects Net

// Wywołujesz funkcję z efektem, więc musisz go zadeklarować u siebie.
fn notify(id: UserId, receipt: Receipt)
  effects Db.read, Net

  user = get_user(id)
  send_receipt(user.email, receipt)

// Tak się nie skompiluje:
//
//   fn notify(id: UserId, receipt: Receipt)
//     effects Db.read
//     user = get_user(id)
//     send_receipt(user.email, receipt)
//
// błąd: notify wywołuje send_receipt, który wymaga Net, a notify go nie deklaruje
